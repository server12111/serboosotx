BOT_TOKEN=
ADMIN_IDS=

ICHEATBOT_API_KEY=
ICHEATBOT_BASE_URL=https://icheatbot.com/api/v2

CRYPTOBOT_TOKEN=

# Used directly by docker-compose.yml to set the postgres container's password and
# build DATABASE_URL — required when deploying via `docker compose up`. Not read by
# the bot itself (that reads the full DATABASE_URL below).
POSTGRES_PASSWORD=

# Local/non-Docker default. docker-compose.yml overrides this at container runtime to
# point at the postgres/redis services using POSTGRES_PASSWORD above.
DATABASE_URL=postgresql+asyncpg://boosty:boosty@localhost:5432/boosty
REDIS_URL=redis://localhost:6379/0

DEFAULT_MARKUP_PERCENT=30
DEFAULT_REFERRAL_PERCENT=5
CATALOG_SYNC_INTERVAL_SEC=3600
ORDER_POLL_INTERVAL_SEC=90
INVOICE_POLL_INTERVAL_SEC=15

SUPPORT_USERNAME=
LOG_LEVEL=INFO
LOGS_PATH=data/logs
