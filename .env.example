BOT_TOKEN=
ADMIN_IDS=

ICHEATBOT_API_KEY=
ICHEATBOT_BASE_URL=https://icheatbot.com/api/v2

CRYPTOBOT_TOKEN=

# Persistent volume path on the host — the main SQLite DB, the FSM-state SQLite DB,
# logs, and the single-instance lock file all live under here. Leave as "data" for
# local runs; set to your platform's mounted persistent-storage path in production
# (e.g. /app/data).
DATA_DIR=data

# Optional overrides — both derive from DATA_DIR above by default, only set these if
# you need the DB and FSM-state files somewhere other than under DATA_DIR.
# DATABASE_URL=sqlite+aiosqlite:///data/boosty.db
# FSM_DB_PATH=data/fsm.db

DEFAULT_MARKUP_PERCENT=30
DEFAULT_REFERRAL_PERCENT=5
CATALOG_SYNC_INTERVAL_SEC=3600
ORDER_POLL_INTERVAL_SEC=90
INVOICE_POLL_INTERVAL_SEC=15

SUPPORT_USERNAME=
LOG_LEVEL=INFO
